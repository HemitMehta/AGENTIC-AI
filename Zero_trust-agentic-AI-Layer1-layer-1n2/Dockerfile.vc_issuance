FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

EXPOSE 8004

HEALTHCHECK --interval=10s --timeout=3s --retries=3 \
  CMD python -c "import httpx; httpx.get('http://localhost:8004/health', timeout=2)" || exit 1

CMD ["python", "-m", "uvicorn", "vc_issuance_service:app", "--host", "0.0.0.0", "--port", "8004"]
